# Copy this file to .env.local and fill in the values from your Supabase project:
#   Project URL      → Project Settings → Data API (or the "Connect" button)
#   Publishable key  → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
# Without these the site still runs, using the built-in sample content.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
